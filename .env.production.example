# Production Environment Variables for Render Deployment
# Copy these to Render's environment variables section, replacing values with actual secrets

# Database: Use Neon PostgreSQL connection string
DB_URL=postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require

# Database Credentials (will be in the connection string above, but Render may need them separately)
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password

# JWT Secret (generate a strong random key)
JWT_SECRET=your-production-jwt-secret-key-min-32-chars-recommended

# CORS: Allow your Vercel frontend domain
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# Server Port (Render sets this automatically, but can be overridden)
PORT=8080

# JWT Expiration
JWT_EXPIRATION_MS=86400000

# Logging in production
JAVA_OPTS=-Dspring.jpa.show-sql=false

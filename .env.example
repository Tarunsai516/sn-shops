## ============================================================
## SN Shops - Environment Variables Template
## Copy this file: cp .env.example .env
## Then fill in your actual values — NEVER commit .env to git!
## ============================================================

## ===== PostgreSQL (Docker Compose) =====
POSTGRES_DB=snshopsDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password

## ===== Backend (Spring Boot) =====
# For local dev (non-Docker): set these in backend/.env or as system env vars
DB_URL=jdbc:postgresql://localhost:5432/snshopsDB
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JWT Secret: generate a strong key -> openssl rand -base64 64
JWT_SECRET=your_base64_encoded_jwt_secret_min_32_chars
JWT_EXPIRATION_MS=86400000

# CORS: comma-separated list of allowed frontend origins
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

## ===== Frontend (Vite / React) =====
# The public URL of the deployed backend (used in production build)
VITE_API_BASE_URL=http://localhost:8080

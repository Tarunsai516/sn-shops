## ============================================================
## SN Shops - Environment Variables Template
## Copy this file: cp .env.example .env
## Then fill in your actual values — NEVER commit .env to git!
## ============================================================

## ===== MySQL (Docker Compose) =====
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=snshops_db
MYSQL_USER=snshops_user
MYSQL_PASSWORD=your_strong_db_password

## ===== Backend (Spring Boot) =====
# For local dev (non-Docker): set these in backend/.env or as system env vars
DB_URL=jdbc:mysql://localhost:3306/snshops_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# JWT Secret: generate a strong key -> openssl rand -base64 64
JWT_SECRET=your_base64_encoded_jwt_secret_min_32_chars
JWT_EXPIRATION_MS=86400000

# CORS: comma-separated list of allowed frontend origins
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

## ===== Frontend (Vite / React) =====
# The public URL of the deployed backend (used in production build)
VITE_API_BASE_URL=http://localhost:8080
